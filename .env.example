# IntentRail environment — NEVER commit real keys.

NEAR_NETWORK=testnet
ALLOW_MAINNET=false

# Read-only 1Click dry quotes (mainnet API, no deposit). Default true.
ALLOW_DRY_QUOTES=true

# Optional partner JWT for 1Click (not required)
# ONECLICK_JWT=

RATE_LIMIT_RPM=30
MAX_LOSS_PER_TRADE_USD=2
DAILY_SPEND_CAP_USD=25
MAX_SLIPPAGE_BPS=100
REQUIRE_HUMAN_APPROVAL=true

# Optional NEAR AI Cloud (roadmap). Off by default. Needs API key from cloud.near.ai
NEAR_AI_ENABLED=false
# NEAR_AI_API_KEY=
# NEAR_AI_API_BASE=https://cloud.near.ai/v1
# NEAR_AI_MODEL=
