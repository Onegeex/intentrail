# IntentRail — NEVER commit real keys.

# Default display network for SSR (UI Live mode can opt into mainnet)
NEAR_NETWORK=testnet

# Operator kill switch for hosted mainnet Live mode. Default false = allowed.
MAINNET_DISABLED=false

ALLOW_DRY_QUOTES=true
# ONECLICK_JWT=

RATE_LIMIT_RPM=30
MAX_LOSS_PER_TRADE_USD=2
DAILY_SPEND_CAP_USD=25
MAX_SLIPPAGE_BPS=100
REQUIRE_HUMAN_APPROVAL=true

NEAR_AI_ENABLED=false
