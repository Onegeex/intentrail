# IntentRail environment
# Copy to .env.local for local development. NEVER commit real keys.

# Network: testnet is the default. Mainnet requires BOTH:
#   NEAR_NETWORK=mainnet
#   ALLOW_MAINNET=true
NEAR_NETWORK=testnet
ALLOW_MAINNET=false

# Public RPC (no API keys required for public endpoints)
# NEAR_RPC_URL=https://rpc.testnet.near.org

# Optional: 1Click partner JWT (not required; without it fee is ~0.2%)
# Never put private keys or seed phrases here.
# ONECLICK_JWT=

# App fee recipient on Intents (optional, named account only)
# APP_FEE_RECIPIENT=

# Rate limit (requests per minute per IP for mutating/proposal APIs)
RATE_LIMIT_RPM=30

# Default guardrail policy (USD). Overridable via API but capped server-side.
MAX_LOSS_PER_TRADE_USD=2
DAILY_SPEND_CAP_USD=25
MAX_SLIPPAGE_BPS=100
REQUIRE_HUMAN_APPROVAL=true
