# IntentRail — NEVER commit real keys. Do NOT set mainnet flags on shared hosting.

NEAR_NETWORK=testnet
ALLOW_MAINNET=false

# Read-only 1Click dry quotes (mainnet API, no deposit). Default true.
ALLOW_DRY_QUOTES=true

# Optional partner JWT for 1Click (not required for dry)
# ONECLICK_JWT=

RATE_LIMIT_RPM=30
MAX_LOSS_PER_TRADE_USD=2
DAILY_SPEND_CAP_USD=25
MAX_SLIPPAGE_BPS=100
REQUIRE_HUMAN_APPROVAL=true

# Optional NEAR AI Cloud (off by default)
NEAR_AI_ENABLED=false
# NEAR_AI_API_KEY=
